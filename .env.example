# Copy to .env and fill in real values. Never commit .env.

# Google Maps / Routes / Places (server-side)
GOOGLE_BACKEND_MAPS_KEY=

# Google Maps JavaScript API key served to the browser.
# Falls back to GOOGLE_ANDROID_MAPS_KEY, then to GOOGLE_BACKEND_MAPS_KEY.
GOOGLE_FRONTEND_MAPS_KEY=
GOOGLE_ANDROID_MAPS_KEY=

# RailRadar (Mumbai Local trains)
RAILRADAR_API_KEY=

# Mappls (optional; not used for transit routing)
MAPPLS_STATIC_KEY=

# Backend port (defaults to 8080)
PORT=8080
NODE_ENV=development
