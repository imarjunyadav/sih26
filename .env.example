# Copy to .env and fill in real values. Never commit .env.

# Google Maps / Routes / Places (server-side)
GOOGLE_BACKEND_MAPS_KEY=

# Google Maps JavaScript API key served to the browser.
# Falls back to GOOGLE_ANDROID_MAPS_KEY, then to GOOGLE_BACKEND_MAPS_KEY.
GOOGLE_FRONTEND_MAPS_KEY=
GOOGLE_ANDROID_MAPS_KEY=

# RailRadar (Mumbai Local trains)
RAILRADAR_API_KEY=

# Mappls (optional; not used for transit routing)
MAPPLS_STATIC_KEY=

# Backend port (defaults to 8080)
PORT=8080
NODE_ENV=development

# ── ONDC BAP (Metro TRV11 2.0.0) ─────────────────────────────────────────────
# Generate keys with: node backend/src/ondc/keygen.js
# Register at: https://portal.ondc.org
ONDC_SUBSCRIBER_ID=citylink-122591058801.asia-south1.run.app
ONDC_SUBSCRIBER_URL=https://citylink-122591058801.asia-south1.run.app
ONDC_UNIQUE_KEY_ID=
ONDC_SIGNING_PRIVATE_KEY=
ONDC_SIGNING_PUBLIC_KEY=
ONDC_ENCRYPTION_PRIVATE_KEY=
ONDC_ENCRYPTION_PUBLIC_KEY=
# Set to the signed content from ONDC portal during onboarding
ONDC_SITE_VERIFICATION_SIGNED=
# UAT registry and gateway (pre-prod environment)
ONDC_REGISTRY_URL=https://preprod.registry.ondc.org
ONDC_GATEWAY_URL=https://preprod.gateway.ondc.org
ONDC_ENV=uat
# Set to true to use a generated UUID as payment transaction_id (for Pramaan testing)
ONDC_MOCK_PAYMENT=false
# Optional overrides
ONDC_BUYER_FINDER_FEES_PCT=1
ONDC_COURT_JURISDICTION=Mumbai
ONDC_STATIC_TERMS_URL=
