# CityLink environment variables
# Copy this file to .env and fill in real values. Never commit .env.
#
# In production, inject these as environment variables rather than a .env file.
# Private keys must come from a secrets manager (GCP Secret Manager, AWS SSM, Vault, etc.)

# ── Application ───────────────────────────────────────────────────────────────

PORT=8080
NODE_ENV=development

# ── Google APIs ───────────────────────────────────────────────────────────────
# Server-side key — used for Routes API (journey planning) and Places API (autocomplete).
# Required. Enable: Routes API, Places API (New). Restrict to your server IP.
GOOGLE_BACKEND_MAPS_KEY=

# Browser-safe key — delivered to the browser via GET /api/config/public.
# Used for the Google Maps JavaScript SDK (interactive map, GPS). Optional but recommended.
# If omitted: falls back to GOOGLE_ANDROID_MAPS_KEY, then to none
# (Leaflet/OSM tiles still work; only Maps JS SDK features are affected).
GOOGLE_FRONTEND_MAPS_KEY=
GOOGLE_ANDROID_MAPS_KEY=

# ── RailRadar (Mumbai Local train schedules) ──────────────────────────────────
# Required. Free tier: 50 req/day. Results cached 22 h per station pair.
# Get a key at https://railradar.in
RAILRADAR_API_KEY=

# ── Mappls (optional) ─────────────────────────────────────────────────────────
# Not used in current routing. Reserved for future integration.
MAPPLS_STATIC_KEY=

# ── ONDC BAP (Metro TRV11 v2.0.0) ────────────────────────────────────────────
# CityLink is registered as a BAP under Taqneeki Pvt Ltd's ONDC identity.
# These values come from the ONDC portal (preprod.registry.ondc.org) and the
# key generation step (node backend/src/ondc/keygen.js).
#
# The ONDC registration is already complete — do NOT regenerate keys unless
# you are creating a new registration.

# Your ONDC subscriber ID (the domain name registered with ONDC).
ONDC_SUBSCRIBER_ID=mobility.taqneeki.in

# Your public HTTPS base URL. ONDC BPPs send async callbacks to {URL}/on_search etc.
# Must be reachable by the ONDC network (port 443, valid TLS, DNS must resolve).
ONDC_SUBSCRIBER_URL=https://mobility.taqneeki.in

# UUID assigned by the ONDC portal when you registered your key pair.
# Included in the Authorization header keyId field on every request.
ONDC_UNIQUE_KEY_ID=

# Ed25519 signing keys — used to sign every outbound ONDC request.
# Private key: 64 bytes base64 (libsodium format: seed[0:32] + public[32:64]).
# Public key: 32 bytes base64 (raw). Registered in ONDC registry — not secret.
ONDC_SIGNING_PRIVATE_KEY=   # SECRET — store in secrets manager only
ONDC_SIGNING_PUBLIC_KEY=

# X25519 encryption keys — used only during /on_subscribe challenge decryption.
# Private key: 32 bytes base64 (raw scalar).
# Public key: 44 bytes base64 (SPKI DER format, starts with MCow...). Not secret.
ONDC_ENCRYPTION_PRIVATE_KEY=   # SECRET — store in secrets manager only
ONDC_ENCRYPTION_PUBLIC_KEY=

# Base64 Ed25519 signature of the unique_req_id from the ONDC portal.
# Served at GET /ondc-site-verification.html as proof of domain ownership.
# Generate with: node backend/src/ondc/scripts/sign-site-verification.js <unique_req_id>
ONDC_SITE_VERIFICATION_SIGNED=

# ONDC network endpoints.
# Use preprod.* for pre-production/Pramaan testing.
# Change to registry.ondc.org and gateway.ondc.org for production.
ONDC_REGISTRY_URL=https://preprod.registry.ondc.org
ONDC_GATEWAY_URL=https://preprod.gateway.ondc.org
ONDC_ENV=uat

# Payment settings.
# Set ONDC_MOCK_PAYMENT=true to use an auto-generated UUID as paymentTransactionId
# in /confirm requests — useful for Pramaan testing without a real payment gateway.
ONDC_MOCK_PAYMENT=false

# BAP commission included in payment tags (BUYER_FINDER_FEES_PERCENTAGE).
ONDC_BUYER_FINDER_FEES_PCT=1

# Court jurisdiction for SETTLEMENT_TERMS tags in init/confirm requests.
ONDC_COURT_JURISDICTION=Mumbai

# Optional URL to your static legal terms document (STATIC_TERMS in payment tags).
ONDC_STATIC_TERMS_URL=
